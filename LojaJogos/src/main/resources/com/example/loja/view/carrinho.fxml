<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.loja.controller.CarrinhoController"
            styleClass="tela">
    <top>
        <HBox styleClass="cabecalho" spacing="10">
            <Button text="← Catálogo" onAction="#voltar"/>
            <Label text="Seu carrinho" styleClass="titulo"/>
        </HBox>
    </top>
    <center>
        <ListView fx:id="listaItens">
            <placeholder><Label text="Seu carrinho está vazio."/></placeholder>
            <BorderPane.margin><Insets top="16" bottom="16"/></BorderPane.margin>
        </ListView>
    </center>
    <bottom>
        <HBox spacing="12" styleClass="rodape">
            <Button text="Remover item" onAction="#removerItem"/>
            <Label fx:id="mensagem" styleClass="mensagem"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="total" styleClass="total"/>
            <Button fx:id="botaoPagamento" text="Ir para pagamento"
                    onAction="#irParaPagamento" styleClass="primario"/>
        </HBox>
    </bottom>
</BorderPane>