<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.loja.controller.BibliotecaController"
            styleClass="tela">
    <top>
        <HBox styleClass="cabecalho" spacing="10">
            <Button text="← Catálogo" onAction="#voltar"/>
            <Label text="Minha biblioteca" styleClass="titulo"/>
        </HBox>
    </top>
    <center>
        <StackPane>
            <BorderPane.margin><Insets top="16"/></BorderPane.margin>
            <ListView fx:id="listaJogos"/>
            <Label fx:id="vazio" text="Você ainda não comprou nenhum jogo." styleClass="mensagem"/>
        </StackPane>
    </center>
</BorderPane>